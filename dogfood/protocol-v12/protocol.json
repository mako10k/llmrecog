  "questions": [
    {
      "id": "DGF-SOURCE-001",
      "round_id": "local_path_digest_v12",
      "prompt": "Does every local locator resolve from the artifact directory while remaining inside the explicit verification root?",
      "required_evidence": "Artifact path, explicit root, locator, root-relative resolved path or root-escape diagnostic, and proof that process cwd is not the base",
      "non_goal": "Accepting ambient working-directory resolution, absolute paths, remote locators, or automatic fallback roots"
    },
    {
      "id": "DGF-SOURCE-002",
      "round_id": "local_path_digest_v12",
      "prompt": "Do unchanged exact bytes verify while a one-byte change fails before any selector is presented as checked?",
      "required_evidence": "Expected and actual SHA-256, source state, status 0 versus 4, and repeated byte-identical output",
      "non_goal": "Normalizing bytes, accepting a stale digest, checking an unimplemented selector, or searching for a quote"
    },
    {
      "id": "DGF-SOURCE-003",
      "round_id": "local_path_digest_v12",
      "prompt": "Do missing, escaping, symlink, and non-regular sources fail closed without reading outside the accepted local profile?",
      "required_evidence": "Stable RCG-VERIFY code, unavailable source state, no actual digest, status 4, and read-only filesystem observation",
      "non_goal": "Following symlinks, opening devices, creating files, fetching a network locator, or weakening containment"
    },
    {
      "id": "DGF-SOURCE-004",
      "round_id": "local_path_digest_v12",
      "prompt": "Are JSON and text projections deterministic, source-ordered, and free of source-content disclosure?",
      "required_evidence": "Two identical executions per case, ordered source IDs, typed states and digests, stdout and stderr digests, and inspection for absent source contents",
      "non_goal": "Treating English messages or raw source excerpts as the only machine contract"
    },
    {
      "id": "DGF-SOURCE-005",
      "round_id": "local_path_digest_v12",
      "prompt": "What path or digest friction must change the remaining range-and-quote design or point estimate before selector implementation?",
      "required_evidence": "Reproducible observations bound to this protocol and revision, disposition targets, and explicit point impact for unfinished Phase 5 tasks",
      "non_goal": "Starting selector implementation before observations are dispositioned or expanding into provider work"
    }
  ],
