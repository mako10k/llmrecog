  "questions": [
    {
      "id": "DGF-SOURCE-006",
      "round_id": "local_source_verification_v14",
      "prompt": "Do strict UTF-8, BOM content, LF and CRLF boundaries, and Unicode-scalar columns select exact source text without normalization?",
      "required_evidence": "Verified and rejected encoding cases, non-BMP and cross-line selectors, exact quote digests, and status boundaries",
      "non_goal": "Stripping BOM, replacing invalid bytes, normalizing line endings, or counting UTF-16 code units as columns"
    },
    {
      "id": "DGF-SOURCE-007",
      "round_id": "local_source_verification_v14",
      "prompt": "Do stale ranges and quotes fail independently while an unsealed source remains distinct from a selector mismatch?",
      "required_evidence": "RCG-VERIFY-007, 011, and 012 results with typed digest, range, quote, source, and span states",
      "non_goal": "Repairing selectors, searching for quote text, or treating missing identity as a matching digest"
    },
    {
      "id": "DGF-SOURCE-008",
      "round_id": "local_source_verification_v14",
      "prompt": "Do size and earlier rooted-path protections still fail before hashing or selector checks?",
      "required_evidence": "Over-limit, escape, symlink, non-regular, and missing prerequisites retain null actual digests and not-checked spans",
      "non_goal": "Partial hashing, following a link, reading a device, network fallback, or automatic retry with a broader root"
    },
    {
      "id": "DGF-SOURCE-009",
      "round_id": "local_source_verification_v14",
      "prompt": "Are mixed-source results source-ordered and fully evaluated even when the emitted diagnostic prefix is truncated?",
      "required_evidence": "Two repeated executions, ordered source and span IDs, complete verification projection, diagnostic prefix, result completeness, and exit status",
      "non_goal": "Stopping source reads at the diagnostic limit or reordering failures by code"
    },
    {
      "id": "DGF-SOURCE-010",
      "round_id": "local_source_verification_v14",
      "prompt": "What complete-verifier friction must change producer-contract design or remaining point estimates?",
      "required_evidence": "Reproducible observations bound to protocol v14 with explicit product boundary and point impact",
      "non_goal": "Starting producer, provider, network, release, or related-repository work"
    }
  ],
