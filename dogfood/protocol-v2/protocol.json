  "questions": [
    {
      "id": "DGF-EXPLAIN-001",
      "round_id": "ambiguity_explain_v2",
      "prompt": "Which candidates are positively source-supported, and which are merely declared without support?",
      "required_evidence": "Candidate IDs, support records, grounding references, and the exact explain projection",
      "non_goal": "Treating unsupported as false or excluded"
    },
    {
      "id": "DGF-EXPLAIN-002",
      "round_id": "ambiguity_explain_v2",
      "prompt": "Which variables are grounded closed domains and which remain open or unknown?",
      "required_evidence": "Variable and one_of IDs plus typed resolution and unknown reason codes",
      "non_goal": "Inferring exhaustiveness from a candidate list"
    },
    {
      "id": "DGF-EXPLAIN-003",
      "round_id": "ambiguity_explain_v2",
      "prompt": "Which complete represented assignment is the joint witness for each allowed candidate?",
      "required_evidence": "Ordered witness assignments, effective scope, constraints considered, and completeness",
      "non_goal": "Combining independently viable per-variable values without a joint witness"
    },
    {
      "id": "DGF-EXPLAIN-004",
      "round_id": "ambiguity_explain_v2",
      "prompt": "Does the explanation preserve source meaning without choosing, concluding, or persisting a derived interpretation?",
      "required_evidence": "Source projection, derivation projection, output identity, and responsibility-boundary observation",
      "non_goal": "Promoting a solver witness to a source recognition or downstream decision"
    },
    {
      "id": "DGF-EXPLAIN-005",
      "round_id": "exclusion_explain_v2",
      "prompt": "Which grounded chain forbids the Tanaka and weak-commitment joint assignment while leaving weak commitment allowed with Sato?",
      "required_evidence": "Named one_of and excludes constraints, Sato witness, forbidden pair derivation, and source grounding",
      "non_goal": "Reporting weak commitment as globally excluded"
    },
    {
      "id": "DGF-EXPLAIN-006",
      "round_id": "exclusion_explain_v2",
      "prompt": "Where does positive support coexist with constraint exclusion, and how does audit report that conflict?",
      "required_evidence": "Separate support and viability fields plus RCG-CSP-002 and its constraint IDs",
      "non_goal": "Changing support to conflicted or deleting a constraint to repair viability"
    },
    {
      "id": "DGF-EXPLAIN-007",
      "round_id": "exclusion_explain_v2",
      "prompt": "Which closed variable scopes have no satisfying represented world?",
      "required_evidence": "Closed variable IDs, complete scoped enumeration, RCG-CSP-001 findings, and deterministic ordering",
      "non_goal": "Inventing an unspecified candidate or weakening grounded closure"
    },
    {
      "id": "DGF-EXPLAIN-008",
      "round_id": "exclusion_explain_v2",
      "prompt": "When a bound prevents a proof, is incompleteness reported deterministically as unknown rather than false?",
      "required_evidence": "Repeated bounded command receipts, RCG-RSN-007, complete false, and truncated true",
      "non_goal": "Presenting a limited prefix as a complete exclusion or witness search"
    }
  ],
