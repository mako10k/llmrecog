  "questions": [
    {
      "id": "DGF-CORE-001",
      "round_id": "relational_constraints_v6",
      "prompt": "Which grounded implication chain excludes an antecedent when its consequent is unavailable without positively selecting either candidate?",
      "required_evidence": "RCG-RSN-203, exact antecedent and consequent IDs, joint scope, and final RCG-RSN-206",
      "non_goal": "Assuming the reverse implication or inventing the consequent"
    },
    {
      "id": "DGF-CORE-002",
      "round_id": "relational_constraints_v6",
      "prompt": "When do equal typed values satisfy same_as despite different candidate IDs, and when does an open operand remain indeterminate?",
      "required_evidence": "Exact typed values, RCG-RSN-204 only for known mismatch, and RCG-RSN-001 for open/unbound evaluation",
      "non_goal": "Using labels, candidate identity, or an invented open value as equality evidence"
    },
    {
      "id": "DGF-CORE-003",
      "round_id": "relational_constraints_v6",
      "prompt": "Which known value collision violates distinct_from and how is that grounded relationship retained?",
      "required_evidence": "Both selected candidate values, K_VALUES_DISTINCT grounding, RCG-RSN-205, and deterministic chain order",
      "non_goal": "Treating absence of same_as as proof of distinctness"
    },
    {
      "id": "DGF-CORE-004",
      "round_id": "relational_constraints_v6",
      "prompt": "Can one compound allowed-plus-forbidden question be answered by target-specific explain results, or is bounded composed navigation required?",
      "required_evidence": "Repeated actual explain commands, exact target boundaries, missing navigation facts, and a responsibility-preserving alternative",
      "non_goal": "Widening every target reason chain before evidence shows target relevance"
    },
    {
      "id": "DGF-CORE-005",
      "round_id": "relational_constraints_v6",
      "prompt": "Do all allowed relational candidates retain a complete joint witness across every effective-scope constraint?",
      "required_evidence": "Candidate declaration order, effective scope, all relevant constraint IDs, and one explicit satisfying assignment",
      "non_goal": "Combining individually viable values that have no joint witness"
    },
    {
      "id": "DGF-SPACE-001",
      "round_id": "bounded_space_views_v6",
      "prompt": "Can conjunction filters find the compound targets without becoming a general query or inference language?",
      "required_evidence": "Exact filter object, typed recognition items, support and viability separation, and effective solver scope",
      "non_goal": "Adding arbitrary predicates, joins, ranking, or conclusions"
    },
    {
      "id": "DGF-SPACE-002",
      "round_id": "bounded_space_views_v6",
      "prompt": "Are query items and materialized worlds stable in declaration and candidate order across repeated runs?",
      "required_evidence": "Byte-identical JSON and text, ordered IDs, world indices, and identical exit statuses",
      "non_goal": "Sorting by confidence, preference, probability, or solver backend order"
    },
    {
      "id": "DGF-SPACE-003",
      "round_id": "bounded_space_views_v6",
      "prompt": "Does an exact inspection limit report complete only when the represented generator is exhausted?",
      "required_evidence": "Limit, inspected count, one-step exhaustion behavior, complete and truncated fields",
      "non_goal": "Equating emitted-world count with inspected-assignment count"
    },
    {
      "id": "DGF-SPACE-004",
      "round_id": "bounded_space_views_v6",
      "prompt": "Does low-limit materialization preserve the same typed prefix while require-complete changes only the exit boundary?",
      "required_evidence": "Identical typed prefix, RCG-RSN-007, status 0 without the flag, and status 5 with it",
      "non_goal": "Presenting a truncated prefix as complete or discarding it on status 5"
    },
    {
      "id": "DGF-SPACE-005",
      "round_id": "bounded_space_views_v6",
      "prompt": "How are fully inspected open relational branches reported without emitting an indeterminate world?",
      "required_evidence": "Open variable IDs, indeterminate count, RCG-RSN-001, empty or proved-only worlds, and computational completeness",
      "non_goal": "Inventing an unspecified candidate or treating open as equal, distinct, or false"
    }
  ],
