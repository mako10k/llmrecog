  "question_results": [
    {
      "question_id": "DGF-SPACE-001",
      "status": "answered",
      "summary": "The variable plus viability conjunction returns only C_OPEN_LEFT_RED and retains its source support separately from unknown CSP viability over the two-variable relational scope.",
      "evidence": [
        "SPACE_QUERY_JSON reports the exact filter object kind=null, variable_id=V_OPEN_LEFT, support=null, viability=unknown, and grounded_in_span_id=null.",
        "Its single typed candidate item is supported by S_ADR_SPACE_VIEWS, has viability unknown with RCG-RSN-001, and reports requested scope V_OPEN_LEFT plus effective scope V_OPEN_LEFT,V_OPEN_RIGHT without ranking, joining, or deriving a conclusion."
      ]
    },
    {
      "question_id": "DGF-SPACE-002",
      "status": "answered",
      "summary": "Every bound JSON and text case is byte-identical across its two repetitions, and materialization preserves variable declaration order, candidate order, and consecutive emitted-world indices.",
      "evidence": [
        "All eight repeat pairs have identical exit statuses, stdout digests, and empty-stderr digests.",
        "SPACE_MATERIALIZE_JSON emits world 1 as V_TRIGGER=C_TRIGGER_ON,V_MODE=C_MODE_FAST, world 2 as V_TRIGGER=C_TRIGGER_OFF,V_MODE=C_MODE_FAST, and world 3 as V_TRIGGER=C_TRIGGER_OFF,V_MODE=C_MODE_SAFE; SPACE_MATERIALIZE_TEXT projects the same order."
      ]
    },
    {
      "question_id": "DGF-SPACE-003",
      "status": "answered",
      "summary": "Limits count inspected assignments or query matches and report completion only after the represented generator is known to be exhausted.",
      "evidence": [
        "SPACE_QUERY_LIMIT_JSON uses result_limit=1 and assignment_limit=1, returns one item with complete=false and truncated=true, and exits 1 because further query results remain.",
        "SPACE_MATERIALIZE_JSON uses limit=4, inspects all four Cartesian assignments, emits the three constraint-satisfying worlds, and reports complete=true and truncated=false after exact exhaustion rather than treating the three emitted worlds as the inspection count."
      ]
    },
    {
      "question_id": "DGF-SPACE-004",
      "status": "answered",
      "summary": "At the same scope and limit, ordinary and require-complete materialization preserve the identical typed world prefix, counts, truncation, and RCG-RSN-007 while only the requested boundary field and exit status change.",
      "evidence": [
        "SPACE_MATERIALIZE_LOW_LIMIT_JSON and SPACE_MATERIALIZE_REQUIRE_COMPLETE_JSON both use scope V_TRIGGER and limit 2, inspect two assignments, emit only world 1 as ON plus FAST, and report complete=false, truncated=true, and RCG-RSN-007.",
        "The no-flag result reports require_complete=false and exits 0; the flagged result reports require_complete=true and exits 5 without discarding or altering the world prefix."
      ]
    },
    {
      "question_id": "DGF-SPACE-005",
      "status": "answered",
      "summary": "A fully inspected open same_as branch is computationally complete without being semantically decided: it emits no world and records the indeterminate open branch explicitly.",
      "evidence": [
        "SPACE_MATERIALIZE_OPEN_JSON reports inspected_assignment_count=2, complete=true, truncated=false, worlds=[], and indeterminate_assignment_count=1.",
        "The same result names V_OPEN_RIGHT in open_variable_ids and RCG-RSN-001 in unknown_reasons, without inventing a candidate for the open variable or classifying the branch as satisfied or violated."
      ]
    }
  ],
