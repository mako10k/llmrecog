      ]
    },
    {
      "question_id": "DGF-SOURCE-009",
      "status": "answered",
      "summary": "Mixed-source verification stayed declaration-ordered and evaluated every source before truncating the emitted diagnostic prefix.",
      "evidence": [
        "LOCAL_MIXED_ORDER_JSON reports FIRST then SECOND: FIRST has digest mismatch, while SECOND has digest verified and its SECOND_SPAN quote mismatch, proving both sources were evaluated.",
