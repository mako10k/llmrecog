      ]
    },
    {
      "question_id": "DGF-SOURCE-008",
      "status": "answered",
      "summary": "The byte limit and previously dogfooded rooted-path prerequisites failed closed before unsupported hashing or selector claims.",
      "evidence": [
        "LOCAL_SIZE_LIMIT_JSON returned RCG-VERIFY-006 with source unavailable, actual digest null, every span field not_checked, and status 4.",
