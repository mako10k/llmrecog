span S_REQ_CONSTRAINTS:
  source REQUIREMENTS_DOC
  range 90:1..127:1

span S_TERM_STATES:
  source TERMINOLOGY_DOC
  range 117:1..154:1

span S_SEM_RELATIONAL:
  source SEMANTIC_MODEL_DOC
  range 155:1..237:1

span S_PROV_REASONS:
  source PROVENANCE_DOC
  range 88:1..171:1

span S_ADR_ASSIGNMENTS:
  source PHASE4_ADR_DOC
  range 33:1..124:1

span S_ADR_QUERY_BOUNDARY:
  source PHASE4_ADR_DOC
  range 125:1..173:1

span S_ADR_TEXT:
  source TEXT_ADR_DOC
  range 8:1..42:1

span S_PHASE4_SEQUENCE:
  source IMPLEMENTATION_PHASES_DOC
  range 121:1..151:1

observation O_THREE_VALUED:
  surface "Relational assignments are satisfied, violated, or indeterminate"
  grounded_in [S_REQ_CONSTRAINTS, S_ADR_ASSIGNMENTS]

observation O_SUPPORT_VIABILITY:
  surface "Source support and constraint viability remain separate"
  grounded_in [S_TERM_STATES, S_PROV_REASONS]

observation O_DOGFOOD_GATE:
  surface "Relational dogfood feedback precedes either space route"
  grounded_in [S_ADR_QUERY_BOUNDARY, S_PHASE4_SEQUENCE]

entity E_PHASE4_CORE:
  type semantic_slice
  label "Phase 4 relational core"
  grounded_in [O_THREE_VALUED, S_PHASE4_SEQUENCE]
  support explicit

entity E_TEXT_PROJECTION:
  type result_projection
  label "Complete ExplainResult v2 text projection"
  grounded_in [S_ADR_TEXT]
  support explicit

record R_CORE_BOUNDARY:
  kind property
  subject E_PHASE4_CORE
  predicate responsibility
  value "Deterministic meaning-space classification without choice or persistence"
  grounded_in [S_REQ_CONSTRAINTS, S_ADR_ASSIGNMENTS]
  support explicit

record R_DOGFOOD_BOUNDARY:
  kind property
  subject E_PHASE4_CORE
  predicate next_gate
  value "Disposition relational evidence before query or materialization"
  grounded_in [O_DOGFOOD_GATE]
  support explicit

record R_TEXT_BOUNDARY:
  kind property
  subject E_TEXT_PROJECTION
  predicate field_coverage
  value "Text retains provenance, constraints, derivations, and diagnostics"
  grounded_in [S_ADR_TEXT]
  support explicit

variable V_REQ_TRIGGER:
  value_type symbol
  candidates [C_REQ_ON]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_REQ_ON in V_REQ_TRIGGER:
  value on
  grounded_in [S_SEM_RELATIONAL]
  support explicit

variable V_REQ_MODE:
  value_type symbol
  candidates [C_REQ_FAST, C_REQ_SAFE]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_REQ_FAST in V_REQ_MODE:
  value fast
  grounded_in [S_SEM_RELATIONAL]
  support explicit

candidate C_REQ_SAFE in V_REQ_MODE:
  value safe
  grounded_in [S_SEM_RELATIONAL]
  support explicit

constraint K_REQ_TRIGGER_ONE_OF:
  kind one_of
  variable V_REQ_TRIGGER
  members [C_REQ_ON]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_REQ_MODE_ONE_OF:
  kind one_of
  variable V_REQ_MODE
  members [C_REQ_SAFE]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_REQ_ON_REQUIRES_FAST:
  kind requires
  antecedent C_REQ_ON
  consequent C_REQ_FAST
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]
  support explicit

variable V_SAME_LEFT:
  value_type symbol
  candidates [C_SAME_LEFT_RED]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_SAME_LEFT_RED in V_SAME_LEFT:
  value red
  grounded_in [S_SEM_RELATIONAL]
  support explicit

variable V_SAME_RIGHT:
  value_type symbol
  candidates [C_SAME_RIGHT_RED, C_SAME_RIGHT_BLUE]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_SAME_RIGHT_RED in V_SAME_RIGHT:
  value red
  grounded_in [S_SEM_RELATIONAL]
  support explicit

candidate C_SAME_RIGHT_BLUE in V_SAME_RIGHT:
  value blue
  grounded_in [S_SEM_RELATIONAL]
  support ambiguous

constraint K_SAME_LEFT_ONE_OF:
  kind one_of
  variable V_SAME_LEFT
  members [C_SAME_LEFT_RED]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_SAME_RIGHT_ONE_OF:
  kind one_of
  variable V_SAME_RIGHT
  members [C_SAME_RIGHT_RED, C_SAME_RIGHT_BLUE]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_VALUES_SAME:
  kind same_as
  left V_SAME_LEFT
  right V_SAME_RIGHT
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]
  support explicit

variable V_DISTINCT_LEFT:
  value_type symbol
  candidates [C_DISTINCT_LEFT_RED]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_DISTINCT_LEFT_RED in V_DISTINCT_LEFT:
  value red
  grounded_in [S_SEM_RELATIONAL]
  support explicit

variable V_DISTINCT_RIGHT:
  value_type symbol
  candidates [C_DISTINCT_RIGHT_RED]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_DISTINCT_RIGHT_RED in V_DISTINCT_RIGHT:
  value red
  grounded_in [S_SEM_RELATIONAL]
  support explicit

constraint K_DISTINCT_LEFT_ONE_OF:
  kind one_of
  variable V_DISTINCT_LEFT
  members [C_DISTINCT_LEFT_RED]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_DISTINCT_RIGHT_ONE_OF:
  kind one_of
  variable V_DISTINCT_RIGHT
  members [C_DISTINCT_RIGHT_RED]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_VALUES_DISTINCT:
  kind distinct_from
  left V_DISTINCT_LEFT
  right V_DISTINCT_RIGHT
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]
  support explicit

variable V_OPEN_LEFT:
  value_type symbol
  candidates [C_OPEN_LEFT_RED]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_OPEN_LEFT_RED in V_OPEN_LEFT:
  value red
  grounded_in [S_SEM_RELATIONAL]
  support explicit

variable V_OPEN_RIGHT:
  value_type symbol
  candidates [C_OPEN_RIGHT_BLUE]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_OPEN_RIGHT_BLUE in V_OPEN_RIGHT:
  value blue
  grounded_in [S_SEM_RELATIONAL]
  support ambiguous

constraint K_OPEN_LEFT_ONE_OF:
  kind one_of
  variable V_OPEN_LEFT
  members [C_OPEN_LEFT_RED]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_OPEN_VALUES_SAME:
  kind same_as
  left V_OPEN_LEFT
  right V_OPEN_RIGHT
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]
  support explicit

variable V_NAV_STATE:
  value_type symbol
  candidates [C_NAV_ON, C_NAV_OFF]
  grounded_in [S_ADR_QUERY_BOUNDARY, S_PHASE4_SEQUENCE]

candidate C_NAV_ON in V_NAV_STATE:
  value on
  grounded_in [S_ADR_QUERY_BOUNDARY]
  support explicit

candidate C_NAV_OFF in V_NAV_STATE:
  value off
  grounded_in [S_ADR_QUERY_BOUNDARY]
  support explicit

variable V_NAV_MODE:
  value_type symbol
  candidates [C_NAV_FAST, C_NAV_SAFE]
  grounded_in [S_ADR_QUERY_BOUNDARY, S_PHASE4_SEQUENCE]

candidate C_NAV_FAST in V_NAV_MODE:
  value fast
  grounded_in [S_ADR_QUERY_BOUNDARY]
  support explicit

candidate C_NAV_SAFE in V_NAV_MODE:
  value safe
  grounded_in [S_ADR_QUERY_BOUNDARY]
  support explicit

constraint K_NAV_STATE_ONE_OF:
  kind one_of
  variable V_NAV_STATE
  members [C_NAV_ON, C_NAV_OFF]
  grounded_in [S_REQ_CONSTRAINTS, S_ADR_QUERY_BOUNDARY]
  support explicit

constraint K_NAV_MODE_ONE_OF:
  kind one_of
  variable V_NAV_MODE
  members [C_NAV_FAST, C_NAV_SAFE]
  grounded_in [S_REQ_CONSTRAINTS, S_ADR_QUERY_BOUNDARY]
  support explicit

constraint K_NAV_ON_REQUIRES_FAST:
  kind requires
  antecedent C_NAV_ON
  consequent C_NAV_FAST
  grounded_in [S_ADR_ASSIGNMENTS, S_ADR_QUERY_BOUNDARY]
  support explicit
