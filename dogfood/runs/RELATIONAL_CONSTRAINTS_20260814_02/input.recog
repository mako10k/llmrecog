observation O_DOGFOOD_REPLAY:
  surface "Corrected relational dogfood precedes either space route"
  grounded_in [S_ADR_QUERY_BOUNDARY, S_PHASE4_SEQUENCE]

entity E_PHASE4_CORE:
  type semantic_slice
  label "Phase 4 relational core"
  grounded_in [O_DOGFOOD_REPLAY, S_ADR_ASSIGNMENTS]
  support explicit

record R_CORE_BOUNDARY:
  kind property
  subject E_PHASE4_CORE
  predicate responsibility
  value "Deterministic meaning-space classification without choice or persistence"
  grounded_in [S_REQ_CONSTRAINTS, S_ADR_ASSIGNMENTS]
  support explicit

variable V_REQ_TRIGGER:
  value_type symbol
  candidates [C_REQ_ON]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_REQ_ON in V_REQ_TRIGGER:
  value on
  grounded_in [S_SEM_RELATIONAL]
  support explicit

variable V_REQ_MODE:
  value_type symbol
  candidates [C_REQ_FAST, C_REQ_SAFE]
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]

candidate C_REQ_FAST in V_REQ_MODE:
  value fast
  grounded_in [S_SEM_RELATIONAL]
  support explicit

candidate C_REQ_SAFE in V_REQ_MODE:
  value safe
  grounded_in [S_SEM_RELATIONAL]
  support explicit

constraint K_REQ_TRIGGER_ONE_OF:
  kind one_of
  variable V_REQ_TRIGGER
  members [C_REQ_ON]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_REQ_MODE_ONE_OF:
  kind one_of
  variable V_REQ_MODE
  members [C_REQ_SAFE]
  grounded_in [S_REQ_CONSTRAINTS, S_SEM_RELATIONAL]
  support explicit

constraint K_REQ_ON_REQUIRES_FAST:
  kind requires
  antecedent C_REQ_ON
  consequent C_REQ_FAST
  grounded_in [S_SEM_RELATIONAL, S_ADR_ASSIGNMENTS]
  support explicit

