  "question_results": [
    {
      "question_id": "DGF-CORE-001",
      "status": "answered",
      "summary": "C_REQ_ON remains source-supported but is excluded because K_REQ_MODE_ONE_OF leaves C_REQ_SAFE and K_REQ_ON_REQUIRES_FAST cannot satisfy C_REQ_FAST.",
      "evidence": [
        "REQUIRES_EXPLAIN_JSON reports effective scope V_REQ_TRIGGER,V_REQ_MODE and the ordered RCG-RSN-201/203/206 chain.",
        "RCG-RSN-203 names C_REQ_ON, C_REQ_FAST, and K_REQ_ON_REQUIRES_FAST without selecting the missing consequent or reversing the implication."
      ]
    },
    {
      "question_id": "DGF-CORE-002",
      "status": "answered",
      "summary": "Exact symbol red values satisfy same_as across different candidate IDs, exact red versus blue values yield RCG-RSN-204, and the open operand remains unknown with RCG-RSN-001.",
      "evidence": [
        "SAME_AS_EXPLAIN_JSON reports the allowed C_SAME_LEFT_RED plus C_SAME_RIGHT_RED witness even though the candidate IDs differ.",
        "SAME_AS_MISMATCH_EXPLAIN_JSON reports RCG-RSN-204 for C_SAME_LEFT_RED plus C_SAME_RIGHT_BLUE, while OPEN_RELATIONAL_EXPLAIN_JSON reports unknown with RCG-RSN-001 and no fabricated derivation."
      ]
    },
    {
      "question_id": "DGF-CORE-003",
      "status": "answered",
      "summary": "The known red/red assignment violates K_VALUES_DISTINCT and excludes C_DISTINCT_LEFT_RED through deterministic RCG-RSN-201/205/206 composition.",
      "evidence": [
        "DISTINCT_FROM_EXPLAIN_JSON reports C_DISTINCT_LEFT_RED and C_DISTINCT_RIGHT_RED as the RCG-RSN-205 inputs with K_VALUES_DISTINCT.",
        "The result retains every effective constraint and the authored grounding through S_SEM_RELATIONAL and S_ADR_ASSIGNMENTS."
      ]
    },
    {
      "question_id": "DGF-CORE-004",
      "status": "answered",
      "summary": "Two target-specific results answer the compound question: C_NAV_SAFE proves the allowed OFF plus SAFE witness, while K_NAV_ON_REQUIRES_FAST exposes the blocked ON plus SAFE relationship through RCG-RSN-203; no composed query or wider candidate reason chain is required.",
      "evidence": [
        "COMPOUND_TARGET_EXPLAIN_JSON reports C_NAV_OFF plus C_NAV_SAFE, RCG-RSN-101, and all three relevant constraints.",
        "COMPOUND_CONSTRAINT_EXPLAIN_JSON reports the exact requires operands and RCG-RSN-203 with inputs C_NAV_ON,C_NAV_FAST; both cases are complete, non-truncated, and byte-identical across repetitions."
      ]
    },
    {
      "question_id": "DGF-CORE-005",
      "status": "answered",
      "summary": "Every allowed relational candidate inspected by the protocol retains one complete joint witness over all effective-scope constraints.",
      "evidence": [
        "SAME_AS_EXPLAIN_JSON reports the joint red/red witness and all left, right, and equality constraints.",
        "COMPOUND_TARGET_EXPLAIN_JSON reports the joint OFF plus SAFE witness and both one_of constraints plus K_NAV_ON_REQUIRES_FAST."
      ]
    }
  ],
