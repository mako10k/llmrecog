{
  "name": "llmrecog",
  "version": "0.0.0",
  "private": true,
  "description": "Source-bounded semantic recognition DSL and deterministic core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dogfood:cli": "node --import tsx src/adapters/internal-cli.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint .",
    "check:duplication": "jscpd src test scripts eslint.config.js --config .jscpd.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"schemas/**/*.json\" \"contracts/**/*.json\" \"dogfood/**/*.json\" \"test/fixtures/**/*.json\" \"*.{json,js}\" \".jscpd.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"schemas/**/*.json\" \"contracts/**/*.json\" \"dogfood/**/*.json\" \"test/fixtures/**/*.json\" \"*.{json,js}\" \".jscpd.json\" \".github/workflows/*.yml\"",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:duplication && npm run format:check && npm test && npm run check:docs && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.15.21",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.30.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.3.0",
    "jscpd": "5.0.15",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
