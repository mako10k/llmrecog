{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mako10k.github.io/llmrecog/schemas/Llmrecog.ExplainResult.v2.schema.json",
  "title": "Llmrecog.ExplainResult.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "semantic_version",
    "tool_version",
    "input",
    "complete",
    "truncated",
    "target",
    "recognition",
    "support",
    "viability",
    "variable_resolution",
    "scope",
    "provenance",
    "normalization",
    "source_verification",
    "relevant_constraint_ids",
    "skipped_constraints",
    "derivations",
    "diagnostics"
  ],
  "properties": {
    "schema": { "const": "Llmrecog.ExplainResult.v2" },
    "semantic_version": { "const": "0.1" },
    "tool_version": { "type": "string", "minLength": 1 },
    "input": {
      "$ref": "Llmrecog.Common.v1.schema.json#/$defs/input"
    },
    "complete": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "target": {
      "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/target"
    },
    "recognition": {
      "$ref": "Llmrecog.SemanticDocument.v1.schema.json#/$defs/recognition"
    },
    "support": {
      "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/support_projection"
    },
    "viability": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/allowed" },
        { "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/excluded" },
        { "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/unknown" }
      ]
    },
    "variable_resolution": {
      "oneOf": [
        {
          "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/variable_resolution"
        },
        { "type": "null" }
      ]
    },
    "scope": {
      "oneOf": [
        { "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/scope" },
        { "type": "null" }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "Llmrecog.Common.v1.schema.json#/$defs/provenance_edge"
      }
    },
    "normalization": {
      "oneOf": [
        {
          "$ref": "Llmrecog.SemanticDocument.v1.schema.json#/$defs/normalization"
        },
        { "type": "null" }
      ]
    },
    "source_verification": {
      "type": "array",
      "items": {
        "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/source_verification_entry"
      }
    },
    "relevant_constraint_ids": {
      "type": "array",
      "items": {
        "$ref": "Llmrecog.Common.v1.schema.json#/$defs/identifier"
      }
    },
    "skipped_constraints": {
      "type": "array",
      "items": {
        "$ref": "Llmrecog.ExplainResult.v1.schema.json#/$defs/skipped_constraint"
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "$ref": "Llmrecog.Common.v1.schema.json#/$defs/reason"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "Llmrecog.Common.v1.schema.json#/$defs/diagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "truncated": { "const": true } },
        "required": ["truncated"]
      },
      "then": {
        "properties": { "complete": { "const": false } }
      }
    },
    {
      "if": {
        "properties": { "complete": { "const": true } },
        "required": ["complete"]
      },
      "then": {
        "properties": { "truncated": { "const": false } }
      }
    }
  ]
}
