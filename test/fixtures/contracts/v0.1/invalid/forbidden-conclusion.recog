llmrecog 0.1

document FORBIDDEN_CONCLUSION:
  title "Conclusion belongs to llmthink"

source SRC:
  kind text
  locator "requirements.txt"

span S1:
  source SRC
  range 1:1..1:20

entity E_PROJECT:
  type project
  label "project"
  grounded_in [S1]
  support explicit

record R_UNSAFE:
  kind conclusion
  subject E_PROJECT
  value unsafe
  grounded_in [S1]
  support explicit
