llmrecog 0.1

document UNGROUNDED_CONSTRAINT:
  title "Constraint relationship has no grounding"

source SRC:
  kind text
  locator "input.txt"

span S1:
  source SRC
  range 1:1..1:12

variable V_VALUE:
  value_type symbol
  candidates [C_A, C_B]
  grounded_in [S1]

candidate C_A in V_VALUE:
  value a
  grounded_in [S1]

candidate C_B in V_VALUE:
  value b
  grounded_in [S1]

constraint K_UNGROUNDED:
  kind excludes
  left C_A
  right C_B
